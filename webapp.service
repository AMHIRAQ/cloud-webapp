[Unit]
Description=Flask Web App (Gunicorn)
After=network.target postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/webapp
EnvironmentFile=/etc/webapp.env
ExecStart=/home/ubuntu/webapp/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
